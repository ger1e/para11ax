# Copy to .env for local development and populate locally.
# Never commit real values. Production secrets belong in Vercel environment variables.

PARA11AX_TOKEN=
PARA11AX_USER_SCANNER_URL=
PARA11AX_USER_SCANNER_TOKEN=
# Server-owned authorization scopes. These are trusted deployment configuration, never caller input.
PARA11AX_OWNED_CIDRS=
PARA11AX_VERIFIED_DOMAINS=
ABUSECH_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
# GreyNoise Project Swarm datasets: greynoise, community, personal.
# Defaults to all three when unset; restrict this list only if your workspace requires it.
GREYNOISE_WORKSPACE_LABELS=greynoise,community,personal
VIRUSTOTAL_API_KEY=
HYBRID_ANALYSIS_API_KEY=
URLSCAN_API_KEY=
WEBAMON_API_KEY=
SENTRY_AUTH_TOKEN=
OTX_API_KEY=
SHODAN_API_KEY=
CENSYS_PAT=
# Non-secret organization scope required by Censys certificate-history queries.
CENSYS_ORG_ID=
PULSEDIVE_API_KEY=
IPINFO_TOKEN=
MALPEDIA_API_TOKEN=
NVD_API_KEY=
VULNCHECK_API_TOKEN=
MWDB_API_TOKEN=
CHAINABUSE_API_KEY=
SHADOWSERVER_API_KEY=
SHADOWSERVER_API_SECRET=
HIBP_API_KEY=
HUDSONROCK_API_KEY=
SPYCLOUD_API_KEY=
DNSDB_API_KEY=
VALIDIN_API_KEY=
SPUR_TOKEN=
NETIFY_API_KEY=
CLOUDFLARE_RADAR_TOKEN=
RANSOMWARE_LIVE_API_KEY=
MODAT_API_KEY=
